# Player-provided LLM credentials. Do not copy Agent environment keys.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.example.com/v1
USER_LLM_MODEL=your-model-name

# Agent service
ZERO_HOST=127.0.0.1
ZERO_PORT=8765
ZERO_MEMORY_DIR=../../data/memory

# Engine
UNITY_HANDS_ONLY=1
UNITY_PASSTHROUGH=1
