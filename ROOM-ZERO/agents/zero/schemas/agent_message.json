{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMessage",
  "type": "object",
  "required": ["from", "to", "type", "trace_id", "payload"],
  "properties": {
    "from": { "type": "string" },
    "to": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["observe", "propose", "reject", "commit", "adapt", "remember"]
    },
    "trace_id": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "payload": { "type": "object" }
  }
}
