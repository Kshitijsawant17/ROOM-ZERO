{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission",
  "type": "object",
  "required": ["id", "title", "seed", "duration_s", "difficulty", "objective", "beats", "placements"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "seed": { "type": "integer" },
    "duration_s": { "type": "integer" },
    "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"] },
    "objective": { "type": "string" },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["intro", "infiltrate", "puzzle", "npc", "extraction", "epilogue"]
          },
          "text": { "type": "string" }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prefab", "surface_id"],
        "properties": {
          "prefab": { "type": "string" },
          "surface_id": { "type": "string" },
          "puzzle_id": { "type": "string" }
        }
      }
    },
    "npcs": { "type": "array" },
    "fail_states": { "type": "array" },
    "memory_hooks": { "type": "array" }
  }
}
